POSTGRES_DB=nagrik_setu
POSTGRES_USER=nagrik
POSTGRES_PASSWORD=replace-with-a-local-development-password
FRONTEND_URL=http://localhost:8080
TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TEXT_MODEL_REVISION=main
IMAGE_MODEL_NAME=google/vit-base-patch16-224
IMAGE_MODEL_REVISION=main
DUPLICATE_SIMILARITY_THRESHOLD=0.72
DUPLICATE_SEARCH_RADIUS_KM=100
# Optional legacy MinIO service; enable with --profile legacy-storage only
MINIO_ROOT_USER=replace-with-a-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-root-password
MINIO_APP_USER=replace-with-a-minio-app-user
MINIO_APP_PASSWORD=replace-with-a-strong-minio-app-password
