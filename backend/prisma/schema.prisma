generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ComplaintStatus {
  SUBMITTED
  AI_ANALYSIS
  ASSIGNED
  UNDER_INVESTIGATION
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AIJobStatus {
  NOT_CONFIGURED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.VarChar(320)
  passwordHash    String          @map("password_hash")
  role            Role
  status          AccountStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  citizenProfile  CitizenProfile?
  officerProfile  OfficerProfile?
  complaints      Complaint[]     @relation("ComplaintCitizen")
  assignments     ComplaintAssignment[]
  notes           InvestigationNote[]
  notifications   Notification[]
  feedback        Feedback[]
  duplicateReviews DuplicateReview[] @relation("DuplicateReviewer")
  auditLogs       AuditLog[]
  sessions        RefreshToken[]

  @@index([role, status])
  @@map("users")
}

model CitizenProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(160)
  phone     String?  @db.VarChar(32)
  address   String?
  state     String?  @db.VarChar(100)
  district  String?  @db.VarChar(100)
  city      String?  @db.VarChar(100)
  pincode   String?  @db.VarChar(12)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("citizen_profiles")
}

model OfficerProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  fullName     String       @map("full_name") @db.VarChar(160)
  departmentId String?      @map("department_id") @db.Uuid
  jurisdiction String?
  phone        String?      @db.VarChar(32)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@map("officer_profiles")
}

model Department {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(160)
  code        String           @unique @db.VarChar(32)
  description String?
  state       String?          @db.VarChar(100)
  district    String?          @db.VarChar(100)
  jurisdiction String?
  active      Boolean          @default(true)
  officers    OfficerProfile[]
  categories  ComplaintCategory[]
  complaints  Complaint[]
  assignments ComplaintAssignment[]

  @@map("departments")
}

model ComplaintCategory {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @unique @db.VarChar(120)
  departmentId   String?      @map("department_id") @db.Uuid
  defaultPriority Priority    @default(MEDIUM) @map("default_priority")
  slaHours       Int          @default(72) @map("sla_hours")
  active         Boolean      @default(true)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  complaints     Complaint[]
  sla            SLAConfiguration[]

  @@map("complaint_categories")
}

model Complaint {
  id             String               @id @default(uuid()) @db.Uuid
  trackingId     String               @unique @map("tracking_id") @db.VarChar(40)
  citizenId      String               @map("citizen_id") @db.Uuid
  categoryId     String               @map("category_id") @db.Uuid
  departmentId   String?              @map("department_id") @db.Uuid
  title          String               @db.VarChar(200)
  description    String
  severity       Priority
  priority       Priority             @default(MEDIUM)
  status         ComplaintStatus      @default(SUBMITTED)
  incidentAt    DateTime?            @map("incident_at") @db.Timestamptz(6)
  consent        Boolean              @default(false)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  citizen        User                 @relation("ComplaintCitizen", fields: [citizenId], references: [id], onDelete: Restrict)
  category       ComplaintCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  images         ComplaintImage[]
  location       ComplaintLocation?
  assignments    ComplaintAssignment[]
  notes          InvestigationNote[]
  resolutionEvidence ResolutionEvidence[]
  history        ComplaintStatusHistory[]
  notifications  Notification[]
  feedback       Feedback?
  duplicateReviews DuplicateReview[] @relation("ComplaintDuplicateReview")
  duplicateCandidates DuplicateReview[] @relation("DuplicateCandidate")
  aiAnalyses     AIAnalysis[]

  @@index([citizenId, createdAt])
  @@index([status, priority, createdAt])
  @@index([departmentId, status])
  @@index([categoryId, createdAt])
  @@map("complaints")
}

model ComplaintImage {
  id          String     @id @default(uuid()) @db.Uuid
  complaintId String     @map("complaint_id") @db.Uuid
  objectKey   String     @unique @map("object_key")
  contentType String     @map("content_type") @db.VarChar(100)
  sizeBytes   Int        @map("size_bytes")
  checksum    String?    @db.VarChar(128)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_images")
}

model ComplaintLocation {
  complaintId String     @id @map("complaint_id") @db.Uuid
  address     String
  state       String     @db.VarChar(100)
  district    String     @db.VarChar(100)
  city        String     @db.VarChar(100)
  pincode     String     @db.VarChar(12)
  latitude    Decimal    @db.Decimal(10, 7)
  longitude   Decimal    @db.Decimal(10, 7)
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([state, district, city])
  @@map("complaint_locations")
}

model ComplaintAssignment {
  id           String      @id @default(uuid()) @db.Uuid
  complaintId  String      @map("complaint_id") @db.Uuid
  officerId    String      @map("officer_id") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  assignedById String?     @map("assigned_by_id") @db.Uuid
  active       Boolean     @default(true)
  assignedAt   DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt      DateTime?   @map("ended_at") @db.Timestamptz(6)
  complaint    Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officer      User        @relation(fields: [officerId], references: [id], onDelete: Restrict)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([officerId, active])
  @@index([complaintId, active])
  @@map("complaint_assignments")
}

model InvestigationNote {
  id          String     @id @default(uuid()) @db.Uuid
  complaintId String     @map("complaint_id") @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  body        String
  isPublic    Boolean    @default(false) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([complaintId, createdAt])
  @@map("investigation_notes")
}

model ResolutionEvidence {
  id          String     @id @default(uuid()) @db.Uuid
  complaintId String     @map("complaint_id") @db.Uuid
  objectKey   String     @unique @map("object_key")
  contentType String     @map("content_type") @db.VarChar(100)
  sizeBytes   Int        @map("size_bytes")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("resolution_evidence")
}

model ComplaintStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  fromStatus  ComplaintStatus? @map("from_status")
  toStatus    ComplaintStatus @map("to_status")
  note        String?
  actorId     String?         @map("actor_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_status_history")
}

model Notification {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  complaintId String?     @map("complaint_id") @db.Uuid
  type        String      @db.VarChar(60)
  message     String
  readAt      DateTime?   @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint   Complaint?  @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Feedback {
  id          String     @id @default(uuid()) @db.Uuid
  complaintId String     @unique @map("complaint_id") @db.Uuid
  citizenId   String     @map("citizen_id") @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizen     User       @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  @@map("feedback")
}

model DuplicateReview {
  id            String     @id @default(uuid()) @db.Uuid
  complaintId   String     @map("complaint_id") @db.Uuid
  candidateId   String     @map("candidate_id") @db.Uuid
  reviewerId    String     @map("reviewer_id") @db.Uuid
  decision      String     @db.VarChar(40)
  similarity    Decimal?   @db.Decimal(5, 4)
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint     Complaint  @relation("ComplaintDuplicateReview", fields: [complaintId], references: [id], onDelete: Cascade)
  candidate     Complaint  @relation("DuplicateCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  reviewer      User       @relation("DuplicateReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([complaintId, createdAt])
  @@map("duplicate_reviews")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model SLAConfiguration {
  id          String            @id @default(uuid()) @db.Uuid
  categoryId  String?           @map("category_id") @db.Uuid
  priority    Priority?
  responseHours Int             @map("response_hours")
  resolutionHours Int           @map("resolution_hours")
  active      Boolean           @default(true)
  category    ComplaintCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, priority, active])
  @@map("sla_configurations")
}

model AIAnalysis {
  id          String       @id @default(uuid()) @db.Uuid
  complaintId String       @map("complaint_id") @db.Uuid
  status      AIJobStatus  @default(QUEUED)
  result      Json?
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  complaint   Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("ai_analyses")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model TrackingSequence {
  year  Int    @id
  value Int    @default(0)

  @@map("tracking_sequences")
}
